@echo off
chcp 65001 > NUL
title 業務課依頼管理ツール サーバー起動中

echo ========================================================
echo   業務課依頼管理ツール サーバーを起動しています...
echo ========================================================
echo.

cd /d "%~dp0"

echo [1/2] 最新ビルドを確認・生成中...
call npm run build

echo.
echo [2/2] 本番サーバーを起動中...
echo.
echo --------------------------------------------------------
echo   【社内共有用URL】 (他のPCからアクセスするURL)
echo   ポータル画面 : http://192.168.1.147:3000
echo   管理者画面   : http://192.168.1.147:3000/admin
echo --------------------------------------------------------
echo   ※このウィンドウを閉じるとサーバーが停止します。
echo ========================================================
echo.

call npm run start
pause
